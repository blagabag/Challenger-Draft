# ─── Required ───────────────────────────────────────────────
# Your bot's token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your bot's Application ID (found on the General Information page)
CLIENT_ID=your_application_id_here

# ─── Optional ────────────────────────────────────────────────
# Set this to your server's ID to register commands instantly during dev.
# Remove it (or leave blank) for global commands.
GUILD_ID=your_guild_id_here
